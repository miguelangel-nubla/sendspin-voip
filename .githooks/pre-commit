#!/usr/bin/env bash
set -e

echo "==> Running pre-commit checks..."

# 1. Check formatting on staged Go files
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)

if [ -n "$STAGED_GO_FILES" ]; then
    echo "-> Checking gofmt..."
    UNFORMATTED=$(gofmt -s -l $STAGED_GO_FILES)
    if [ -n "$UNFORMATTED" ]; then
        echo "ERROR: The following Go files are not formatted with 'gofmt -s':"
        echo "$UNFORMATTED"
        echo ""
        echo "Run 'make fmt' and re-stage before committing."
        exit 1
    fi
fi

# 2. Run go vet
echo "-> Running go vet..."
go vet ./...

# 3. Run unit tests
echo "-> Running unit tests..."
CGO_ENABLED=0 go test -short ./...

echo "==> Pre-commit checks passed!"
